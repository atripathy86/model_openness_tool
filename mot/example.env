# Hugging Face and GitHub connectors (optional for public resources)
HF_TOKEN=
GITHUB_TOKEN=

# OpenAI-compatible LLM extraction
OPENAI_BASE_URL=
OPENAI_API_KEY=

# Externally provided MinerU inference service
MINERU_SERVER_URL=

# MOT API authentication (blank disables bearer authentication)
MOT_API_BEARER_TOKEN=
MOT_API_PORT=8000
MOT_LOG_LEVEL=INFO

# PostgreSQL / SQLAlchemy
POSTGRES_DB=mot
POSTGRES_USER=mot
POSTGRES_PASSWORD=mot-local
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://mot:mot-local@127.0.0.1:5432/mot
